{
  "name": "five-dice",
  "version": "1.0.0",
  "description": "Five Dice — a cozy mountain-lodge dice table (StarHermit game 89), on the StarHermit engine.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:native",
    "test:unit": "node tests/run.js && node --test tests/progress.test.mjs tests/i18n.test.mjs",
    "test:native": "node tests/native.mjs",
    "test:browser": "node tools/browser-play.mjs .",
    "package": "node tools/package-web.mjs",
    "css": "node tools/css.mjs",
    "plays": "node tools/gen-plays.mjs",
    "textures": "node tools/bake-textures.mjs",
    "start": "node server.js"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
